# ==========================================
# GRIOT Environment Configuration Example
# ==========================================

# Supabase (Backend Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
SUPABASE_PROJECT_ID=your-project-id

# Vite Supabase Env (Client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Next / SSR Compatibility
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# AI Model Provider Keys (Server-side)
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Connected Compute & Execution Runner
GRIOT_RUNTIME_EXECUTOR_URL=
GRIOT_RUNTIME_SHARED_SECRET=
VITE_GRIOT_RUNTIME_EXECUTOR_URL=
GRIOT_EXECUTION_GATEWAY_INTERNAL_KEY=

# Stripe Payments & Webhooks
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Lovable & Cron Tasks
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
LOVABLE_API_KEY=